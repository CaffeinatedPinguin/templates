# AI review configuration. Every command MUST read the prompt from stdin and write the review to stdout.
# It runs without tool or write access. Check the flags on your machine (`--help`); the lines below are patterns only.

# Cheap model for ordinary PRs (for example opencode with a model from OpenCode Go):
AI_CHEAP=""
# AI_CHEAP='opencode run -m <provider/model>'

# Stronger model only for PRs that touch risky files (workflows, dependencies, auth):
AI_STRONG=""
# AI_STRONG='claude -p'
# AI_STRONG='codex exec --sandbox read-only -'

# Hard limit for one call (seconds) and PR size (added + removed lines).
AI_TIMEOUT=600
MAX_LINES=800

# "Risky" files (ERE on paths) -> AI_STRONG
RISKY_RE='^\.github/|(^|/)Dockerfile|(^|/)(package\.json|pyproject\.toml|go\.mod|Cargo\.toml|requirements[^/]*\.txt)$|auth|crypt|secret|token|passw|\.(sh|ps1)$'

# Files cut from the diff (saves tokens): lockfiles, generated, minified
SKIP_RE='(^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|poetry\.lock|uv\.lock|Cargo\.lock|go\.sum)$|\.min\.(js|css)$|(^|/)dist/'

# Local state (so the same commit is not reviewed twice)
STATE_DIR="$HOME/.cache/gh-ai-review"
