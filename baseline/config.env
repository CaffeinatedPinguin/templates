# gh-baseline configuration. The only file you edit; scripts read it with `source`, so it is plain bash.

# Your GitHub login (repository owner).
OWNER="CaffeinatedPinguin"

# Repositories covered by the baseline (without "OWNER/"). Empty = all public, non-archived,
# non-fork repositories of OWNER. Pilot: one repository.
REPOS=(starter-page)

# Repositories skipped even in "all" mode.
EXCLUDE=(.github templates)

# Name of the required check (job in the caller's ci.yml). Do not change without changing the caller.
CI_CHECK="ci-required"

# Policy for workflow runs from fork PRs (defense in depth; outside PRs are blocked by "Collaborators only").
FORK_PR_APPROVAL="all_external_contributors"

# 1 = require signed commits on main. With squash-merge through GitHub, GitHub signs the commit itself.
REQUIRE_SIGNED=1

# Discussions: false = Issues is the only channel. WARNING: disabling hides existing discussions.
DISCUSSIONS=false

# 1 = try to set the branch-name ruleset (metadata rules are probably Enterprise-only; CI checks names by default).
BRANCH_RULESET=0

# 1 = enable the baseline-main ruleset (PR required, squash only, required check CI_CHECK).
# Keep 0 until CI_CHECK has been green on the first PR of the repository; then set 1 and rerun apply.sh <repo>.
MAIN_RULESET=1

# Allowed actions and reusable workflows besides GitHub-owned ones (patterns_allowed). Reusable workflows are
# listed by exact file path because wildcard matching across "/" is not documented.
ACTION_PATTERNS=(
  "pnpm/action-setup@*"
  "docker/*"
  "$OWNER/templates/.github/workflows/node-ci.yml@*"
  "$OWNER/templates/.github/workflows/docker.yml@*"
  "$OWNER/templates/.github/workflows/release.yml@*"
  "$OWNER/templates/.github/workflows/conventions.yml@*"
  "$OWNER/templates/.github/workflows/dependency-review.yml@*"
)

# 1 = enable CodeQL default setup (free on public repositories, also analyzes workflows).
CODEQL=1

# 1 = delete labels that are not in labels.tsv (GitHub defaults such as "good first issue", "wontfix").
PRUNE_LABELS=1
