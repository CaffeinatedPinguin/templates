#!/usr/bin/env bash
# Local Conventional Commits guard (installed by bin/sync-files.sh).
# Skips: fixup!/squash!/amend!, merge, revert generated by git.
msg_file=$1
subject=$(grep -vE '^\s*#' "$msg_file" | sed -n '1p')
types='feat|fix|docs|refactor|perf|test|build|ci|chore|revert'

[[ "$subject" =~ ^(fixup|squash|amend)! ]] && exit 0
[[ "$subject" =~ ^Merge\  ]] && exit 0
[[ "$subject" =~ ^Revert\ \" ]] && exit 0

if [[ ! "$subject" =~ ^($types)(\([a-z0-9._/-]+\))?!?:\ [^[:space:]].*[^.[:space:]]$ ]]; then
  cat >&2 <<EOF
✗ Commit message does not follow Conventional Commits:
    $subject
  Format: type(scope)!: imperative summary   (no trailing dot)
  Types:  ${types//|/, }
  Example: fix(parser): handle empty config file
EOF
  exit 1
fi
if (( ${#subject} > 72 )); then
  echo "! Subject is ${#subject} characters (recommended <= 72)." >&2
fi
exit 0
