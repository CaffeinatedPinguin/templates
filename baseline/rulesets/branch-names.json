{
  "name": "baseline-branch-names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["~ALL"], "exclude": ["~DEFAULT_BRANCH"] }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "type/kebab-slug",
        "negate": false,
        "operator": "regex",
        "pattern": "^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)/[a-z0-9][a-z0-9._-]{1,48}$|^dependabot/.+$|^gh-readonly-queue/.+$"
      }
    }
  ]
}
